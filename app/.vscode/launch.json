{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run / Debug Qt App",
      "type": "cppdbg",
      "request": "launch",
      "program": "${command:cmake.launchTargetPath}",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [
        {
          "name": "LD_LIBRARY_PATH",
          "value": "${env:HOME}/Qt/6.11.2/gcc_64/lib:${env:LD_LIBRARY_PATH}"
        },
        {
          "name": "QML_IMPORT_PATH",
          "value": "${workspaceFolder}/build"
        }
      ],
      "externalConsole": false,
      "MIMode": "gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    }
  ]
}